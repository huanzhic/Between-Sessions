{
  "name": "@between-sessions/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ai:check": "tsx scripts/check-deepseek.ts",
    "ai:summary": "tsx scripts/demo-summary.ts",
    "preai:summary": "npm run build --workspace @between-sessions/contracts",
    "dev": "tsx watch src/index.ts",
    "predev": "npm run build --workspace @between-sessions/contracts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "pretest": "npm run build --workspace @between-sessions/contracts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@between-sessions/contracts": "*"
  }
}

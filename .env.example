# Copy to .env and fill in locally. Never commit real values.
# Use fictional data only until the Render and Anthropic BAAs are signed.

# API
PORT=3000

# Better Auth: API URL and the exact browser origin allowed to make auth requests.
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# Postgres (Render Postgres in production)
DATABASE_URL=postgres://user:password@localhost:5432/between_sessions

# Claude API (HIPAA-ready organization in production)
ANTHROPIC_API_KEY=
